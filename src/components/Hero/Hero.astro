---
import './Hero.scss'
---

<main class="hero container" id="hero-scene">
    <div class="hero__content">
        <div class="hero__text">
            <h1 class="hero__title">
                Hi, I’m Dan a.k.a
                <span class="hero__title-accent">
          DanTheDev22
        </span>
            </h1>
            <p class="hero__description">
                I’m a Full-Stack Developer
            </p>
        </div>

        <div class="hero__actions">
            <a href="#projects-section" class="hero__button hero__button--primary">
                <span class="hero__button-text">See My Work</span>
            </a>
            <a href="#contact-section" class="hero__button hero__button--secondary">
                Let's Talk
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero__button-icon">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
            <a href="" download class="hero__button hero__button--secondary visible-mobile">
                See Resume
            </a>
        </div>
    </div>

    <div class="profile-card visible-mobile">
        <div class="profile-card__frame">

            <div class="profile-card__photo-wrapper">
                <img
                        src="public/photo-self.png"
                        alt="Dan — Full Stack Developer"
                        class="profile-card__photo"
                />
            </div>

            <div class="profile-card__socials">
                <a href="https://github.com/DanTheDev22" target="_blank" rel="noopener noreferrer" class="profile-card__social-link" aria-label="GitHub">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M12.5005 18.3334V15C12.6164 13.9561 12.3171 12.9085 11.6671 12.0834C14.1671 12.0834 16.6671 10.4167 16.6671 7.50002C16.7338 6.45835 16.4421 5.43335 15.8338 4.58335C16.0671 3.62502 16.0671 2.62502 15.8338 1.66669C15.8338 1.66669 15.0005 1.66669 13.3338 2.91669C11.1338 2.50002 8.86715 2.50002 6.66715 2.91669C5.00048 1.66669 4.16715 1.66669 4.16715 1.66669C3.91715 2.62502 3.91715 3.62502 4.16715 4.58335C3.56037 5.42992 3.26587 6.46068 3.33381 7.50002C3.33381 10.4167 5.83381 12.0834 8.33381 12.0834C8.00881 12.4917 7.76715 12.9584 7.62548 13.4584C7.48381 13.9584 7.44215 14.4834 7.50048 15V18.3334" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M7.50033 15C3.74199 16.6666 3.33366 13.3333 1.66699 13.3333" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>

                <a href="https://x.com/DanTheDev22" target="_blank" rel="noopener noreferrer" class="profile-card__social-link" aria-label="X (Twitter)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M3.33301 3.33331L13.1105 16.6666H16.6663L6.88884 3.33331H3.33301" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3.33301 16.6666L8.97301 11.0266M11.023 8.97665L16.6663 3.33331" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>

                <a href="https://linkedin.com/in/DanTheDev22" target="_blank" rel="noopener noreferrer" class="profile-card__social-link" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M15 8C17.7614 8 20 10.2386 20 13V18.8333H16.6667V13C16.6667 12.0795 15.9205 11.3333 15 11.3333C14.0795 11.3333 13.3333 12.0795 13.3333 13V18.8333H10V13C10 10.2386 12.2386 8 15 8V8" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 9H5.33333V9V19V19H2V19V9V9V9" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 3.66667C2 4.58652 2.74681 5.33333 3.66667 5.33333C4.58652 5.33333 5.33333 4.58652 5.33333 3.66667C5.33333 2.74681 4.58652 2 3.66667 2C2.74681 2 2 2.74681 2 3.66667V3.66667" stroke="#B0B0B0" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>

        </div>
    </div>

</main>

