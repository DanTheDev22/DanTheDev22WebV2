---
import './Projects.scss'
---

<section class="projects" id="projects-section">
    <div class="projects__container container">

        <div class="projects__header">
            <h2 class="projects__title">Personal projects</h2>
            <p class="projects__subtitle">Projects I designed and built to solve real problems</p>
        </div>

        <div class="projects__list">

            <article class="project">
                <div class="project__preview swiper">

                    <div class="swiper-wrapper">
                        <video
                                autoplay
                                muted
                                loop
                                playsinline
                                width="750"
                                class="project__preview-video swiper-slide">
                            <source src="public/videos/1.provider.mp4" type="video/mp4" />
                        </video>

                        <video
                                autoplay
                                muted
                                loop
                                playsinline
                                width="750"
                                class="project__preview-video swiper-slide">
                            <source src="public/videos/2.commands.mp4" type="video/mp4" />
                        </video>

                        <video
                                autoplay
                                muted
                                loop
                                playsinline
                                width="750"
                                class="project__preview-video swiper-slide">
                            <source src="public/videos/3.alerts.mp4" type="video/mp4" />
                        </video>
                    </div>
                    <div class="swiper-pagination"></div>
                </div>

                <div class="project__info">

                    <div class="project__container">

                        <div class="project__info-head">
                            <h2 class="project__title">Tradebot</h2>
                            <p class="project__desc">Telegram-based financial assistant for quick market access and automated workflows.</p>

                            <div class="project__actions">
                                <a class="project__action primary" href="https://t.me/my_trading_assist_bot">
                                    Live demo
